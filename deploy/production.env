# Non-secret production settings, committed so changes are reviewed like code.
# The deploy workflow writes the server's .env from this file + GitHub secrets
# (.github/workflows/ci-cd.yml). Never put a key, password or connection string here.

ENVIRONMENT=production
DEBUG=false

# arXiv + PDF parsing
ARXIV__SEARCH_CATEGORY=cs.AI
ARXIV__MAX_RESULTS=15
ARXIV__PDF_CACHE_DIR=data/arxiv_pdfs
PDF_PARSER__MAX_PAGES=30
PDF_PARSER__DO_OCR=false

# Services inside the Docker network (compose.yml also sets this for the api and airflow containers)
OPENSEARCH__HOST=http://opensearch:9200

# Embeddings (each provider has its own chunk index; switching needs a reindex)
EMBEDDINGS__PROVIDER=openai
EMBEDDINGS__DIMENSIONS=1024

# LLM
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
BEDROCK_MODEL_ID=
AWS_REGION=us-east-2

# Tracing / monitoring
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LOGFIRE__ENABLED=true
LOGFIRE__SERVICE_NAME=arxiv-rag
LOGFIRE__ENVIRONMENT=production
LOGFIRE__SEND_TO_LOGFIRE=if-token-present

# AWS Bedrock Guardrails (credentials come from the EC2 instance role).
# DRAFT until a numbered version is created in the Bedrock console; then set it here (e.g. 1).
GUARDRAILS__ENABLED=true
GUARDRAILS__VERSION=DRAFT
GUARDRAILS__REGION=us-east-2

# DeepEval online evals (scores on Langfuse traces)
ONLINE_EVAL__ENABLED=true
ONLINE_EVAL__SAMPLE_RATE=0.2
ONLINE_EVAL__JUDGE_MODEL=gpt-4o
DEEPEVAL_TELEMETRY_OPT_OUT=1
