# Copy to .env and fill in real values:   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit .env.

ENVIRONMENT=development
DEBUG=false

# ---------- Phase 1: Neon Postgres (papers) ----------
# Neon console -> your project -> Connect -> copy the connection string
POSTGRES_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------- Phase 1: OpenSearch ----------
# localhost when running the API on your machine; compose.yml overrides this inside Docker.
OPENSEARCH__HOST=http://localhost:9200

# ---------- Phase 2: arXiv + PDF parsing ----------
ARXIV__SEARCH_CATEGORY=cs.AI
ARXIV__MAX_RESULTS=15
ARXIV__PDF_CACHE_DIR=data/arxiv_pdfs
PDF_PARSER__MAX_PAGES=30
PDF_PARSER__DO_OCR=false

# ---------- Phase 2: Airflow ----------
AIRFLOW_ADMIN_PASSWORD=change-me
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# ---------- Phase 4: embeddings (hybrid search) ----------
# openai or jina. Each provider gets its own chunk index; after switching, run:
#   uv run python scripts/index_papers.py
EMBEDDINGS__PROVIDER=openai
EMBEDDINGS__DIMENSIONS=1024
JINA_API_KEY=

# ---------- Phase 5: LLM (RAG answers) ----------
# openai or bedrock. Bedrock reads AWS credentials from `aws configure` / env vars / instance role.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# Optional tuning (defaults shown)
# RAG__TOP_K=5
# RAG__MAX_TOKENS=800
# RAG__TEMPERATURE=0.2

# ---------- Phase 6: cache + tracing ----------
# Redis runs in Docker (compose sets REDIS__URL for the API). Optional: REDIS__TTL_SECONDS=21600
# Langfuse: cloud.langfuse.com -> your project -> Settings -> API Keys. Leave empty to disable tracing.
# EU region: https://cloud.langfuse.com   US region: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------- Phase 7: agent ----------
# Searches per question (first search + rewrites). Optional.
# AGENT__MAX_RETRIEVALS=2

# ---------- Logfire (app-level monitoring) ----------
# logfire.pydantic.dev -> your project -> Settings -> Write tokens. Leave the token empty to disable.
LOGFIRE__ENABLED=true
LOGFIRE__TOKEN=
LOGFIRE__SERVICE_NAME=arxiv-rag
LOGFIRE__ENVIRONMENT=development
# "if-token-present" sends only when a token is set; "false" never sends
LOGFIRE__SEND_TO_LOGFIRE=if-token-present


# ---------- AWS Bedrock Guardrails ----------
# Bedrock console -> Guardrails -> your guardrail -> ID and version. Credentials: IAM role on EC2,
# ~/.aws (aws configure) locally. Content filters, prompt attacks, PII masking, grounding check.

GUARDRAILS__ENABLED=true
GUARDRAILS__ID=
# Optional (defaults shown):
# GUARDRAILS__GROUNDING_ACTION=flag     # flag | block | off
# GUARDRAILS__FAIL_OPEN=true            # false = refuse requests when AWS is unreachable
# GUARDRAILS__CHECK_INPUT=true
# GUARDRAILS__CHECK_OUTPUT=true
GUARDRAILS__VERSION=1
GUARDRAILS__REGION=us-east-2
# ---------- Online evals: DeepEval, scores on Langfuse traces ----------
# Needs Langfuse (above) and OPENAI_API_KEY for the judge. Optional (defaults shown):
# ONLINE_EVAL__ENABLED=true
# ONLINE_EVAL__SAMPLE_RATE=0.2
# ONLINE_EVAL__JUDGE_MODEL=gpt-4o
# ONLINE_EVAL__MAX_PENDING=20
DEEPEVAL_TELEMETRY_OPT_OUT=1
